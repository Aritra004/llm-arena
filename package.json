{
  "name": "@jsmastery/skills",
  "version": "2.0.0",
  "description": "A phase based engineering workflow as Agent Skills. Takes a change from a vague idea to shipped, verified, documented code, for any AI coding agent.",
  "keywords": [
    "claude-code",
    "cursor",
    "ai-coding",
    "skills",
    "agent-skills",
    "developer-tools",
    "javascript-mastery"
  ],
  "homepage": "https://github.com/JavaScript-Mastery-Pro/skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/JavaScript-Mastery-Pro/skills.git"
  },
  "license": "MIT",
  "author": "JavaScript Mastery",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "simple-git-hooks",
    "check": "node scripts/check-portability.mjs",
    "test": "pnpm check && node scripts/check-data-model.mjs && pnpm test:models",
    "test:models": "tsx --test tests/*.test.ts",
    "models:sync": "tsx prisma/seed.ts",
    "test:data-model:database": "node scripts/test-data-model-migration.mjs",
    "tokens": "node scripts/analyze-token-usage.mjs"
  },
  "dependencies": {
    "@arcjet/next": "^1.10.0",
    "@clerk/nextjs": "^7.8.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "next": "^15.3.5",
    "pg": "^8.23.0",
    "posthog-js": "^1.418.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.5",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0"
  }
}
